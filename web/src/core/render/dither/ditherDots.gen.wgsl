// Generated by shader-gen from ditherDots.wgsl and its includes. Do not edit.

// Draws the dither: finds the grid cell of each pixel, reads the cell's average
// color from the cells pass, turns it into ink or paper by the chosen threshold
// pattern, and draws the dot shape inside the cell.
//
// Bindings: the cells at 0, the blue-noise tile at 1 and the error-diffusion
// mask at 2. A pass that uses neither binds a 1x1 stand-in.

// Shared by the dither passes: the params block, the mode constants, the tone
// curve, the threshold patterns and the palette lookups.
// Bindings: params at 6 (see params.ts for the packing order).
//
// The grid is measured in device pixels from `gridOrigin` on the surface, and a
// cell is `cellPx` wide. Rows are counted from the top of the screen. A texture
// the passes share stores its rows from the top on WebGPU and from the bottom
// on WebGL2, so `cellRow` converts between the two orders.

struct DitherParams {
  frame: vec4<f32>,    // x,y = surface size (px)  z = cell size (px)  w = 1 when texture rows run top to bottom
  grid: vec4<f32>,     // x,y = grid origin on the surface (px)  z,w = first cell column and row
  cells: vec4<f32>,    // x,y = cell columns and rows  z = taps per cell side  w = frame counter
  modes: vec4<f32>,    // x = pattern  y = dot shape  z = palette mode  w = levels (0 = continuous)
  flags: vec4<f32>,    // x = 1 to reseed noise every frame  y = diffusion kernel  z = palette size
  tone: vec4<f32>,     // x = gamma  y = contrast  z = brightness  w = 1 to invert
  dot: vec4<f32>,      // x = dot scale  y = smallest dot radius  z = edge softness (px)  w = alpha threshold
  misc: vec4<f32>,     // x = palette spread
  paper: vec4<f32>,    // the color of an empty cell. Alpha 0 leaves the gaps transparent
  ink: vec4<f32>,      // the color of a full cell
  palette: array<vec4<f32>, 16>,
};
@group(0) @binding(6) var<uniform> params: DitherParams;

const PATTERN_BAYER2: u32 = 0u;
const PATTERN_BAYER4: u32 = 1u;
const PATTERN_BAYER8: u32 = 2u;
const PATTERN_BLUE_NOISE: u32 = 3u;
const PATTERN_WHITE_NOISE: u32 = 4u;
const PATTERN_INTERLEAVED_GRADIENT: u32 = 5u;
const PATTERN_DIFFUSION: u32 = 6u;
const PATTERN_NONE: u32 = 7u;

const DOT_SQUARE: u32 = 0u;
const DOT_SQUARE_INSET: u32 = 1u;
const DOT_CIRCLE: u32 = 2u;
const DOT_CIRCLE_AM: u32 = 3u;
const DOT_SQUARE_AM: u32 = 4u;

const PALETTE_MONO: u32 = 0u;
const PALETTE_RAMP: u32 = 1u;
const PALETTE_NEAREST: u32 = 2u;
const PALETTE_SOURCE: u32 = 3u;

const LUMA: vec3<f32> = vec3<f32>(0.2126, 0.7152, 0.0722);
const PI: f32 = 3.14159265;

fn rowsRunTopToBottom() -> bool {
  return params.frame.w > 0.5;
}

// Converts a row between top-to-bottom order and the texture's own order. The
// conversion is its own inverse.
fn cellRow(row: i32, rowCount: i32) -> i32 {
  return select(rowCount - 1 - row, row, rowsRunTopToBottom());
}

fn hash21(point: vec2<f32>) -> f32 {
  var mixed = fract(vec3<f32>(point.xyx) * 0.1031);
  mixed += dot(mixed, mixed.yzx + 33.33);
  return fract((mixed.x + mixed.y) * mixed.z);
}

// Ordered (Bayer) threshold in (0, 1) for a matrix of side 2^bits. Each bit
// pair of the coordinates contributes one base-4 digit, most significant first.
fn bayerThreshold(cell: vec2<i32>, bits: u32) -> f32 {
  let side = 1u << bits;
  let wrapped = vec2<u32>(vec2<i32>(cell.x & i32(side - 1u), cell.y & i32(side - 1u)));
  var rank = 0u;
  for (var bit = 0u; bit < bits; bit++) {
    let xBit = (wrapped.x >> bit) & 1u;
    let yBit = (wrapped.y >> bit) & 1u;
    rank = rank * 4u + ((xBit ^ yBit) << 1u) + yBit;
  }
  return (f32(rank) + 0.5) / f32(side * side);
}

fn interleavedGradientThreshold(cell: vec2<i32>) -> f32 {
  let point = vec2<f32>(cell);
  return fract(52.9829189 * fract(0.06711056 * point.x + 0.00583715 * point.y));
}

// Gamma, contrast and brightness on one channel, then the optional inversion.
fn toneMap(value: f32) -> f32 {
  var tone = pow(max(value, 0.0), params.tone.x);
  tone = (tone - 0.5) * params.tone.y + 0.5 + params.tone.z;
  tone = clamp(tone, 0.0, 1.0);
  if (params.tone.w > 0.5) {
    tone = 1.0 - tone;
  }
  return tone;
}

fn toneRgb(color: vec3<f32>) -> vec3<f32> {
  return vec3<f32>(toneMap(color.r), toneMap(color.g), toneMap(color.b));
}

// Snaps `value` to one of `levels` evenly spaced values. A threshold in (0, 1)
// decides which neighbor wins, which is what makes the result look dithered.
fn quantize(value: f32, threshold: f32, levels: u32) -> f32 {
  let steps = f32(max(levels, 2u) - 1u);
  return clamp(floor(value * steps + threshold), 0.0, steps) / steps;
}

fn paletteSize() -> i32 {
  return clamp(i32(params.flags.z), 1, 16);
}

fn rampColor(level: f32) -> vec4<f32> {
  let last = paletteSize() - 1;
  return params.palette[clamp(i32(round(level * f32(last))), 0, 15)];
}

fn nearestPaletteColor(color: vec3<f32>) -> vec4<f32> {
  var best = params.palette[0];
  var bestDistance = 1e9;
  for (var index = 0; index < paletteSize(); index++) {
    let candidate = params.palette[index];
    let offset = color - candidate.rgb;
    let squaredDistance = dot(offset, offset);
    if (squaredDistance < bestDistance) {
      bestDistance = squaredDistance;
      best = candidate;
    }
  }
  return best;
}

// A color with its alpha folded in, as the engine's targets hold it.
fn premultiply(color: vec4<f32>) -> vec4<f32> {
  return vec4<f32>(color.rgb * color.a, color.a);
}
// The fullscreen vertex the drawing passes share. The pipeline supplies the
// triangle, with the uv already in the order the backend samples.

struct VertexOut {
  @builtin(position) position: vec4<f32>,
  @location(0) uv: vec2<f32>,
};

@vertex
fn vs_main(
  @location(0) a_pos: vec2<f32>,
  @location(1) a_uv: vec2<f32>,
) -> VertexOut {
  var out: VertexOut;
  out.uv = a_uv;
  out.position = vec4<f32>(a_pos, 0.0, 1.0);
  return out;
}

@group(0) @binding(0) var u_tex: texture_2d<f32>;
@group(0) @binding(16) var u_texSamp: sampler;
@group(0) @binding(1) var u_tex1: texture_2d<f32>;
@group(0) @binding(17) var u_tex1Samp: sampler;
@group(0) @binding(2) var u_tex2: texture_2d<f32>;
@group(0) @binding(18) var u_tex2Samp: sampler;

fn blueNoiseThreshold(cell: vec2<i32>) -> f32 {
  let side = vec2<i32>(textureDimensions(u_tex1, 0));
  var wrapped = cell;
  if (params.flags.x > 0.5) {
    // A different low-discrepancy offset of the tile each frame.
    let shift = floor(vec2<f32>(side) * fract(vec2<f32>(0.7548777, 0.5698403) * floor(params.cells.w)));
    wrapped = wrapped + vec2<i32>(shift);
  }
  wrapped = ((wrapped % side) + side) % side;
  // The byte's center within its 1/256 step, so no threshold reaches 0 or 1
  // and a cell of pure black or pure white never flips.
  return (textureLoad(u_tex1, wrapped, 0).r * 255.0 + 0.5) / 256.0;
}

fn cellThreshold(cell: vec2<i32>) -> f32 {
  switch (u32(params.modes.x)) {
    case PATTERN_BAYER2: { return bayerThreshold(cell, 1u); }
    case PATTERN_BAYER4: { return bayerThreshold(cell, 2u); }
    case PATTERN_BAYER8: { return bayerThreshold(cell, 3u); }
    case PATTERN_BLUE_NOISE: { return blueNoiseThreshold(cell); }
    case PATTERN_WHITE_NOISE: {
      let reseed = select(0.0, floor(params.cells.w) * 13.37, params.flags.x > 0.5);
      return hash21(vec2<f32>(cell) + vec2<f32>(reseed));
    }
    case PATTERN_INTERLEAVED_GRADIENT: { return interleavedGradientThreshold(cell); }
    default: { return 0.5; }
  }
}

// The color of a quantized cell in the threshold patterns.
fn cellColor(level: f32, threshold: f32, source: vec3<f32>) -> vec4<f32> {
  switch (u32(params.modes.z)) {
    case PALETTE_RAMP: { return rampColor(level); }
    case PALETTE_NEAREST: {
      let nudged = clamp(toneRgb(source) + vec3<f32>((threshold - 0.5) * params.misc.x), vec3<f32>(0.0), vec3<f32>(1.0));
      return nearestPaletteColor(nudged);
    }
    case PALETTE_SOURCE: {
      return vec4<f32>(mix(params.paper.rgb, source, level), mix(params.paper.a, 1.0, level));
    }
    default: { return mix(params.paper, params.ink, level); }
  }
}

// The ink color of the shapes whose size follows the tone.
fn inkColor(source: vec3<f32>) -> vec4<f32> {
  switch (u32(params.modes.z)) {
    case PALETTE_RAMP: { return params.palette[paletteSize() - 1]; }
    case PALETTE_NEAREST: { return nearestPaletteColor(toneRgb(source)); }
    case PALETTE_SOURCE: { return vec4<f32>(source, 1.0); }
    default: { return params.ink; }
  }
}

// How much of the cell the dot covers at `inCell` (0 to 1 across the cell),
// anti-aliased over `softness` pixels.
fn dotCoverage(inCell: vec2<f32>, level: f32) -> f32 {
  let cellPx = params.frame.z;
  let edge = max(params.dot.z, 0.01) / cellPx;
  let fromCenter = inCell - vec2<f32>(0.5);
  switch (u32(params.modes.y)) {
    case DOT_SQUARE_INSET: {
      let halfSide = 0.5 * params.dot.x;
      return 1.0 - smoothstep(halfSide - edge, halfSide + edge, max(abs(fromCenter.x), abs(fromCenter.y)));
    }
    case DOT_CIRCLE: {
      let radius = 0.5 * params.dot.x;
      return 1.0 - smoothstep(radius - edge, radius + edge, length(fromCenter));
    }
    case DOT_CIRCLE_AM: {
      if (level <= 0.0005) { return 0.0; }
      // A cell of area 1 gets ink coverage `level` at radius sqrt(level / pi).
      let radius = max(sqrt(level / PI) * params.dot.x, params.dot.y);
      return 1.0 - smoothstep(radius - edge, radius + edge, length(fromCenter));
    }
    case DOT_SQUARE_AM: {
      if (level <= 0.0005) { return 0.0; }
      let halfSide = max(0.5 * sqrt(level) * params.dot.x, params.dot.y);
      return 1.0 - smoothstep(halfSide - edge, halfSide + edge, max(abs(fromCenter.x), abs(fromCenter.y)));
    }
    default: { return 1.0; }
  }
}

@fragment
fn fs_main(in: VertexOut) -> @location(0) vec4<f32> {
  let cellPx = params.frame.z;
  let fromTop = vec2<f32>(in.position.x, select(params.frame.y - in.position.y, in.position.y, rowsRunTopToBottom()));
  let gridPosition = (fromTop - params.grid.xy) / cellPx;
  let cell = vec2<i32>(floor(gridPosition));
  let inCell = fract(gridPosition);

  let cellCount = vec2<i32>(params.cells.xy);
  let local = cell - vec2<i32>(params.grid.zw);
  let texel = vec2<i32>(clamp(local.x, 0, cellCount.x - 1), cellRow(clamp(local.y, 0, cellCount.y - 1), cellCount.y));
  let average = textureLoad(u_tex, texel, 0);

  if (params.dot.w > 0.0 && average.a < params.dot.w) {
    return vec4<f32>(0.0);
  }
  let source = average.rgb / max(average.a, 1e-4);
  let tone = toneMap(dot(source, LUMA));

  var levels = u32(params.modes.w);
  if (u32(params.modes.z) == PALETTE_RAMP) {
    levels = u32(paletteSize());
  }

  var threshold = 0.5;
  var level = tone;
  if (u32(params.modes.x) == PATTERN_DIFFUSION) {
    let maskCount = vec2<i32>(textureDimensions(u_tex2, 0));
    let maskTexel = vec2<i32>(clamp(local.x, 0, maskCount.x - 1), cellRow(clamp(local.y, 0, maskCount.y - 1), maskCount.y));
    level = textureLoad(u_tex2, maskTexel, 0).r;
  } else {
    threshold = cellThreshold(cell);
    if (levels >= 2u) {
      level = quantize(tone, threshold, levels);
    }
  }

  let shape = u32(params.modes.y);
  var result: vec4<f32>;
  if (shape == DOT_CIRCLE_AM || shape == DOT_SQUARE_AM) {
    result = mix(premultiply(params.paper), premultiply(inkColor(source)), dotCoverage(inCell, level));
  } else {
    let color = premultiply(cellColor(level, threshold, source));
    if (shape == DOT_SQUARE) {
      result = color;
    } else {
      result = mix(premultiply(params.paper), color, dotCoverage(inCell, level));
    }
  }
  return result;
}

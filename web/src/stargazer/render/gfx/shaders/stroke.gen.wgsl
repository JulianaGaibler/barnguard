// Instanced-segment stroke program. Expanded-quad line technique: one instance per
// polyline segment, a 6-vert [0,1]×[0,1] unit template. The vertex stage extends
// the quad by (halfWidth + 1 px) past each endpoint so the fragment stage's
// round-cap AA falls inside the quad without a second draw.
//
// `Stroke.coreOnly` splits a deduplicated translucent stroke into two passes.
// Segments overlap at every joint, and a stencil that admits each pixel once
// would otherwise let whichever segment drew first win outright — including
// where its antialiased rim lands inside a later segment's solid core, which
// reads as a pale seam across the joint. Drawing the cores first claims those
// pixels for full coverage, then the fringe pass fills what is left.
//
// The fragment stage is a signed-distance-to-segment with round caps (endpoint
// distance when `along` is outside [0, segLen]), the same linear coverage ramp
// as the shape program's edges, and dashing
// via `mod(dashStart + along, period)` fading out the off half. `dashPeriod == 0`
// is the no-dash fast path. Colors are premultiplied, scaling by a linear
// coverage alpha keeps that.
//
// Bindings match batchLayout.ts: a_unit/a_p0/a_p1/a_color/a_widthDash at
// LOC_STROKE_* (0..4), Frame at FRAME_UBO_BINDING (0).

struct Frame {
  proj: mat3x3<f32>,
  targetH: f32,
  fragYFlip: f32,
};
@group(0) @binding(0) var<uniform> frame: Frame;

// Signed distances and edge coverage shared by the 2D programs. Distance
// functions return (distance, gradient.x, gradient.y).

fn circleDistance(point: vec2<f32>, radius: f32) -> vec3<f32> {
  let fromCenter = length(point);
  let direction = select(vec2<f32>(1.0, 0.0), point / fromCenter, fromCenter > 1e-6);
  return vec3<f32>(fromCenter - radius, direction);
}

// `point` is relative to the box center. `cornerRadii` is (top left,
// top right, bottom right, bottom left).
fn roundBoxDistance(point: vec2<f32>, halfSize: vec2<f32>, cornerRadii: vec4<f32>) -> vec3<f32> {
  let column = select(cornerRadii.xw, cornerRadii.yz, point.x > 0.0);
  let cornerRadius = select(column.x, column.y, point.y > 0.0);
  // Measured against the inner box, the box shrunk by the corner radius, in
  // the point's quadrant folded onto the positive one.
  let fromInnerBox = abs(point) - halfSize + vec2<f32>(cornerRadius);
  let beyondInnerBox = max(fromInnerBox, vec2<f32>(0.0));
  let gapToInnerBox = length(beyondInnerBox);
  let outsideInnerBox = max(fromInnerBox.x, fromInnerBox.y) > 0.0;
  let nearestSide = select(vec2<f32>(0.0, 1.0), vec2<f32>(1.0, 0.0), fromInnerBox.x > fromInnerBox.y);
  let foldedDirection = select(nearestSide, beyondInnerBox / max(gapToInnerBox, 1e-6), outsideInnerBox);
  let distance = select(max(fromInnerBox.x, fromInnerBox.y), gapToInnerBox, outsideInnerBox) - cornerRadius;
  let quadrantSign = select(vec2<f32>(-1.0), vec2<f32>(1.0), point >= vec2<f32>(0.0));
  return vec3<f32>(distance, quadrantSign * foldedDirection);
}

// `fwidth` of a distance, computed exactly from its gradient. `pixelStep.xy`
// and `pixelStep.zw` are the local displacement of one device pixel along x
// and y, so (1, 0, 0, 1) for a shape measured in device pixels.
fn distanceChangePerPixel(gradient: vec2<f32>, pixelStep: vec4<f32>) -> f32 {
  return abs(dot(gradient, pixelStep.xy)) + abs(dot(gradient, pixelStep.zw));
}

// A linear ramp one pixel wide across the edge. Every 2D edge and analytic
// clip uses it, so a `fillCircle` and a `setClip` circle of the same size line
// up exactly.
fn coverage(distance: f32, changePerPixel: f32) -> f32 {
  return clamp(0.5 - distance / max(changePerPixel, 1e-4), 0.0, 1.0);
}

// The run's clip in device pixels, staged by `GpuBatchContext` (see
// batchLayout.ts). Exact only under an axis-aligned transform. Needs the
// including shader's `frame` uniform.
struct Clip {
  kind: f32,
  cx: f32,
  cy: f32,
  r: f32,
  halfW: f32,
  halfH: f32,
  pad0: f32,
  pad1: f32,
  // Rounded box corner radii: top left, top right, bottom right, bottom left.
  radii: vec4<f32>,
};
@group(0) @binding(8) var<uniform> clipShape: Clip;

// Kind 0 is no clip, 1 a circle, 2 a rounded box.
fn clipCoverage(fragPos: vec2<f32>) -> f32 {
  if (clipShape.kind < 0.5) {
    return 1.0;
  }
  // WebGL2's `gl_FragCoord.y` counts up from the bottom.
  let deviceY = select(fragPos.y, frame.targetH - fragPos.y, frame.fragYFlip > 0.5);
  let point = vec2<f32>(fragPos.x, deviceY) - vec2<f32>(clipShape.cx, clipShape.cy);
  var distanceAndGradient: vec3<f32>;
  if (clipShape.kind < 1.5) {
    distanceAndGradient = circleDistance(point, clipShape.r);
  } else {
    distanceAndGradient = roundBoxDistance(
      point,
      vec2<f32>(clipShape.halfW, clipShape.halfH),
      clipShape.radii,
    );
  }
  let changePerPixel = distanceChangePerPixel(distanceAndGradient.yz, vec4<f32>(1.0, 0.0, 0.0, 1.0));
  return coverage(distanceAndGradient.x, changePerPixel);
}

struct Stroke {
  // 1 = keep only near-full coverage (the core pass), 0 = keep everything.
  coreOnly: f32,
  pad0: f32,
  pad1: f32,
  pad2: f32,
};
// Binding 2, not 0: the WebGL2 reflection keys uniform blocks by binding number
// alone with no group, so a group-1 block sharing a number with group 0's Frame
// would bind over it and leave the projection matrix reading garbage.
@group(1) @binding(2) var<uniform> stroke: Stroke;

// Below this, a fragment is antialiasing rather than body. Just under 1 so a
// core fragment that smoothstep leaves a hair short still counts.
const CORE_MIN_COVERAGE: f32 = 0.98;


struct VOut {
  @builtin(position) pos: vec4<f32>,
  @location(0) alongPerp: vec2<f32>,          // (along, perp) in segment-local px
  @location(1) @interpolate(flat) segLen: f32,
  @location(2) @interpolate(flat) halfWidth: f32,
  @location(3) @interpolate(flat) dashStart: f32,
  @location(4) @interpolate(flat) dashPeriod: f32,
  @location(5) @interpolate(flat) dashOnLen: f32,
  @location(6) @interpolate(flat) color: vec4<f32>,
  // The segment's direction in device px, to turn the distance's gradient from
  // segment coordinates into screen axes.
  @location(7) @interpolate(flat) tangent: vec2<f32>,
};

@vertex
fn vs_main(
  @location(0) a_unit: vec2<f32>,
  @location(1) a_p0: vec2<f32>,
  @location(2) a_p1: vec2<f32>,
  @location(3) a_color: vec4<f32>,
  @location(4) a_widthDash: vec4<f32>,        // (width, dashStart, dashPeriod, dashOnLen)
) -> VOut {
  var out: VOut;
  let seg = a_p1 - a_p0;
  let segLen = length(seg);
  // Degenerate p0==p1 (join discs at interior vertices): tangent defaults to +x.
  // The distance test only reads the endpoint case there anyway.
  let tangent = select(vec2<f32>(1.0, 0.0), seg / segLen, segLen > 1e-6);
  let normal = vec2<f32>(-tangent.y, tangent.x);
  let halfWidth = a_widthDash.x * 0.5;

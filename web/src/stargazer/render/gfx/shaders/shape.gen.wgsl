// Generated by shader-gen from shape.wgsl and its includes. Do not edit.

// Shape program. One instanced unit quad covers three shape
// families selected by shapeType (a_shape.x): textured (text + atlas sprites),
// circle SDF, and rounded-box SDF, so text, sprites, and vector shapes share
// one blend-only batch. Each vertex branch positions the quad for its family in
// device px. The fragment branch evaluates the matching SDF or texture sample.
//
// Textured instances pick a fixed-unit texture (atlas or label page) via
// texIndex. Every fetch is a `textureSampleLevel` at level 0 and every edge's
// anti-aliasing width is computed from the distance function's own gradient
// rather than with `fwidth`, so nothing in the fragment stage needs uniform
// control flow and each kind's branch runs only its own work. The pages and
// the ramp atlas have no mipmaps, so level 0 is what `textureSample` read.
//
// A circle or round-rect fill can also be a linear gradient: a_paint carries
// the device-space axis projection (see `packing.ts`'s `gradientAxis`) and a
// row into the shared ramp atlas, encoded `rampRow + 1` so a zeroed (no
// gradient) record reads as 0. The fill's opacity then rides in
// a_colorFill's alpha channel instead of a separate field, since rgb goes
// unused once the ramp supplies the color. The stroke has no paint slot.
//
// Bindings match batchLayout.ts: attributes at LOC_SHAPE_* (0..10), Frame at
// FRAME_UBO_BINDING (0), u_texAtlas at unit 0, u_texLabel at unit 1, u_ramp
// (the shared ramp atlas) at unit 2, ShapeParams (the debug-mode override) at
// SHAPE_PARAMS_UBO_BINDING (9), and the param table (clip records) at
// PARAM_TABLE_BINDING (10) in the frame group.

struct Frame {
  proj: mat3x3<f32>,
  targetH: f32,
  fragYFlip: f32,
};
@group(0) @binding(0) var<uniform> frame: Frame;

fn devicePos(fragPos: vec2<f32>) -> vec2<f32> {
  let fy = select(fragPos.y, frame.targetH - fragPos.y, frame.fragYFlip > 0.5);
  return vec2<f32>(fragPos.x, fy);
}

// Per-primitive records, read by index in the vertex stage (see ParamTable.ts).
// Index 0 is the empty record: kind 0, which is no clip.
@group(0) @binding(10) var<storage, read> paramTable: array<vec4<f32>>;

// Signed distances and edge coverage shared by the 2D programs. Distance
// functions return (distance, gradient.x, gradient.y).

fn circleDistance(point: vec2<f32>, radius: f32) -> vec3<f32> {
  let fromCenter = length(point);
  let direction = select(vec2<f32>(1.0, 0.0), point / fromCenter, fromCenter > 1e-6);
  return vec3<f32>(fromCenter - radius, direction);
}

// `point` is relative to the box center. `cornerRadii` is (top left,
// top right, bottom right, bottom left).
fn roundBoxDistance(point: vec2<f32>, halfSize: vec2<f32>, cornerRadii: vec4<f32>) -> vec3<f32> {
  let column = select(cornerRadii.xw, cornerRadii.yz, point.x > 0.0);
  let cornerRadius = select(column.x, column.y, point.y > 0.0);
  // Measured against the inner box, the box shrunk by the corner radius, in
  // the point's quadrant folded onto the positive one.
  let fromInnerBox = abs(point) - halfSize + vec2<f32>(cornerRadius);
  let beyondInnerBox = max(fromInnerBox, vec2<f32>(0.0));
  let gapToInnerBox = length(beyondInnerBox);
  let outsideInnerBox = max(fromInnerBox.x, fromInnerBox.y) > 0.0;
  let nearestSide = select(vec2<f32>(0.0, 1.0), vec2<f32>(1.0, 0.0), fromInnerBox.x > fromInnerBox.y);
  let foldedDirection = select(nearestSide, beyondInnerBox / max(gapToInnerBox, 1e-6), outsideInnerBox);
  let distance = select(max(fromInnerBox.x, fromInnerBox.y), gapToInnerBox, outsideInnerBox) - cornerRadius;
  let quadrantSign = select(vec2<f32>(-1.0), vec2<f32>(1.0), point >= vec2<f32>(0.0));
  return vec3<f32>(distance, quadrantSign * foldedDirection);
}

// `fwidth` of a distance, computed exactly from its gradient. `pixelStep.xy`
// and `pixelStep.zw` are the local displacement of one device pixel along x
// and y, so (1, 0, 0, 1) for a shape measured in device pixels.
fn distanceChangePerPixel(gradient: vec2<f32>, pixelStep: vec4<f32>) -> f32 {
  return abs(dot(gradient, pixelStep.xy)) + abs(dot(gradient, pixelStep.zw));
}

// A linear ramp one pixel wide across the edge. Every 2D edge and analytic
// clip uses it, so a `fillCircle` and a `setClip` circle of the same size line
// up exactly.
fn coverage(distance: f32, changePerPixel: f32) -> f32 {
  return clamp(0.5 - distance / max(changePerPixel, 1e-4), 0.0, 1.0);
}

// Clip coverage from a param table record (see ParamTable.ts), measured in the
// clip's local space so it holds under rotation and uneven scale. `shape` is
// (kind, centerX, centerY, radius) with kind 0 none, 1 circle, 2 rounded box.
// `box` is (halfWidth, halfHeight, top left radius, top right radius).
// `deviceToLocal` holds the affine's two columns, and `deviceToLocalOffset` its
// translation then the bottom right and bottom left radii.
fn clipCoverageRec(
  devicePixel: vec2<f32>,
  shape: vec4<f32>,
  box: vec4<f32>,
  deviceToLocal: vec4<f32>,
  deviceToLocalOffset: vec4<f32>,
) -> f32 {
  if (shape.x < 0.5) {
    return 1.0;
  }
  let local = vec2<f32>(
    deviceToLocal.x * devicePixel.x + deviceToLocal.z * devicePixel.y + deviceToLocalOffset.x,
    deviceToLocal.y * devicePixel.x + deviceToLocal.w * devicePixel.y + deviceToLocalOffset.y,
  );
  let point = local - shape.yz;
  var distanceAndGradient: vec3<f32>;
  if (shape.x < 1.5) {
    distanceAndGradient = circleDistance(point, shape.w);
  } else {
    let cornerRadii = vec4<f32>(box.zw, deviceToLocalOffset.zw);
    distanceAndGradient = roundBoxDistance(point, box.xy, cornerRadii);
  }
  // The affine's columns are the local displacement of one device pixel.
  let changePerPixel = distanceChangePerPixel(distanceAndGradient.yz, deviceToLocal);
  return coverage(distanceAndGradient.x, changePerPixel);
}
// Distance to an axis-aligned ellipse with radii `radii` centered on the
// origin, exact, from the nearest point on its outline. That point solves a
// quartic, done in closed form as in Inigo Quilez's `sdEllipse`
// (iquilezles.org/articles/ellipsedist). Mirrors `ellipse.ts`, which the
// tests run.
fn ellipseDistance(point: vec2<f32>, radii: vec2<f32>) -> vec3<f32> {
  let quadrantSign = select(vec2<f32>(-1.0), vec2<f32>(1.0), point >= vec2<f32>(0.0));
  // Work in the positive quadrant, with the point nearer the y axis than the
  // x axis, which the closed form assumes.
  let swapped = abs(point.x) > abs(point.y);
  let p = select(abs(point), abs(point).yx, swapped);
  let ab = select(radii, radii.yx, swapped);
  let radiiGap = ab.y * ab.y - ab.x * ab.x;
  var nearest: vec2<f32>;
  if (abs(radiiGap) < 1e-6 * max(ab.x * ab.x, ab.y * ab.y)) {
    // A circle: the nearest point lies straight out from the center.
    let fromCenter = length(p);
    nearest = select(vec2<f32>(0.0, ab.x), p * (ab.x / fromCenter), fromCenter > 1e-6);
  } else {
    let m = ab.x * p.x / radiiGap;
    let m2 = m * m;
    let n = ab.y * p.y / radiiGap;
    let n2 = n * n;
    let c = (m2 + n2 - 1.0) / 3.0;
    let c3 = c * c * c;
    let q = c3 + m2 * n2 * 2.0;
    let discriminant = c3 + m2 * n2;
    let g = m + m * n2;
    var cosine: f32;
    if (discriminant < 0.0) {
      let angle = acos(clamp(q / c3, -1.0, 1.0)) / 3.0;
      let s = cos(angle);
      let t = sin(angle) * sqrt(3.0);
      let rootX = sqrt(max(0.0, -c * (s + t + 2.0) + m2));
      let rootY = sqrt(max(0.0, -c * (s - t + 2.0) + m2));
      cosine = (rootY + sign(radiiGap) * rootX + abs(g) / max(rootX * rootY, 1e-12) - m) / 2.0;
    } else {
      let h = 2.0 * m * n * sqrt(discriminant);
      let s = sign(q + h) * pow(abs(q + h), 1.0 / 3.0);
      let u = sign(q - h) * pow(abs(q - h), 1.0 / 3.0);
      let rootX = -s - u - c * 4.0 + 2.0 * m2;
      let rootY = (s - u) * sqrt(3.0);
      let rootLength = length(vec2<f32>(rootX, rootY));
      cosine = (rootY / sqrt(max(rootLength - rootX, 1e-12)) + 2.0 * g / max(rootLength, 1e-12) - m) / 2.0;
    }
    cosine = clamp(cosine, 0.0, 1.0);
    nearest = ab * vec2<f32>(cosine, sqrt(1.0 - cosine * cosine));
  }
  let offset = p - nearest;
  let gap = length(offset);
  let inside = p.y < nearest.y;
  // Away from the nearest point, flipped toward it when inside, so the
  // gradient always points outward. On the outline, the outline's normal.
  let normal = nearest / (ab * ab);
  let onOutline = normal / max(length(normal), 1e-12);
  var direction = select(onOutline, select(offset, -offset, inside) / max(gap, 1e-12), gap > 1e-6);
  direction = select(direction, direction.yx, swapped);
  return vec3<f32>(select(gap, -gap, inside), quadrantSign * direction);
}

@group(1) @binding(0) var u_texAtlas: texture_2d<f32>;
@group(1) @binding(16) var u_texAtlasSamp: sampler;
@group(1) @binding(1) var u_texLabel: texture_2d<f32>;
@group(1) @binding(17) var u_texLabelSamp: sampler;
@group(1) @binding(2) var u_ramp: texture_2d<f32>;
@group(1) @binding(18) var u_rampSamp: sampler;
@group(1) @binding(3) var u_cornerField: texture_2d<f32>;
@group(1) @binding(19) var u_cornerFieldSamp: sampler;

// The smooth-corner field's layout. Must match squircleField.ts.
const FIELD_TILES: f32 = 21.0;
const FIELD_PATCH_MIN: f32 = -1.0;
const FIELD_PATCH_SPAN: f32 = 3.0;
// Patch span between neighboring texel centers.
const FIELD_TEXEL: f32 = 3.0 / 64.0;

// Per-run debug-mode override, the HUD's 'overdraw'/'batch-color' modes.
// flags.x: 0 normal, 1 overdraw, 2 batch-color.
struct ShapeParams {
  debugColor: vec4<f32>,
  flags: vec4<u32>,
};
@group(1) @binding(9) var<uniform> params: ShapeParams;

// `max_inter_stage_shader_variables` is 16 locations on WebGPU (0..15). Every
// shape kind's own data packs into a handful of generically-named vec4
// slots instead of one named varying per field, reused differently per
// kind (exactly how the instance record's own words already are). Each
// kind's packing is documented at its `vs_main` branch and unpacked the
// same way in `fs_main`.
struct VOut {
  @builtin(position) pos: vec4<f32>,
  @location(0) @interpolate(flat) shapeType: i32,
  // Smooth (per-fragment interpolated): textured -> uv, circle -> worldPos
  // (device px), round-rect/shadow -> local (centered local coords).
  @location(1) varyingPos: vec2<f32>,
  // Flat: textured -> tint, circle/round-rect/shadow -> fill color.
  @location(2) @interpolate(flat) colorFill: vec4<f32>,
  // Flat: circle/round-rect -> stroke color. Unused otherwise.
  @location(3) @interpolate(flat) colorStroke: vec4<f32>,
  // Flat: circle/round-rect -> fill gradient, see the file header. Unused otherwise.
  @location(4) @interpolate(flat) paint: vec4<f32>,
  // Flat, kind-specific: textured (texIndex, 0, 0, 0); circle (center.x,
  // center.y, radius, strokeWidth); round-rect (halfExt.x, halfExt.y,
  // strokeWidth, strokeOffset); shadow (halfExt.x, halfExt.y, sigma, inset).
  @location(5) @interpolate(flat) paramsA: vec4<f32>,
  // Flat: round-rect/shadow -> corner radii (tl, tr, br, bl). Unused otherwise.
  @location(6) @interpolate(flat) radii: vec4<f32>,
  // Flat, kind-specific: circle (dashStart, dashPeriod, _, _); round-rect
  // each corner's smoothing (tl, tr, br, bl); shadow (offsetX, offsetY,
  // spread, _). Unused otherwise.
  @location(7) @interpolate(flat) paramsB: vec4<f32>,
  // Flat: the clip's param record, four vec4s.
  @location(8) @interpolate(flat) clip0: vec4<f32>,
  @location(9) @interpolate(flat) clip1: vec4<f32>,
  @location(10) @interpolate(flat) clip2: vec4<f32>,
  @location(11) @interpolate(flat) clip3: vec4<f32>,
  // Flat: the local displacement of one device pixel along x (xy) and y (zw),
  // for `distanceChangePerPixel`. Identity for circles, which are in device px.
  @location(12) @interpolate(flat) pixelStep: vec4<f32>,
};

@vertex
fn vs_main(
  @location(0) a_unit: vec2<f32>,
  @location(1) a_mCol0: vec2<f32>,
  @location(2) a_mCol1: vec2<f32>,
  @location(3) a_mTranslate: vec2<f32>,
  @location(4) a_shape: vec4<f32>,       // (shapeType, feather, texIndex, pad/shadowInset)
  @location(5) a_params: vec4<f32>,      // circle (radius, stroke, dashStart, dashPeriod) / rrect+shadow (halfW, halfH, stroke, strokeOffset)
  @location(6) a_radii: vec4<f32>,       // round-rect / shadow corner radii (tl, tr, br, bl)
  @location(7) a_srcRect: vec4<f32>,     // textured (u0, v0, u1, v1) / shadow (sigma, spread, offsetX, offsetY)
  @location(8) a_colorFill: vec4<f32>,   // premultiplied RGBA
  @location(9) a_colorStroke: vec4<f32>, // premultiplied RGBA
  @location(10) a_paint: vec4<f32>,      // fill gradient: see the file header
  @location(11) a_param: u32,            // index of the primitive's param record
) -> VOut {
  var out: VOut;
  let rec = a_param * 4u;
  out.clip0 = paramTable[rec];
  out.clip1 = paramTable[rec + 1u];
  out.clip2 = paramTable[rec + 2u];
  out.clip3 = paramTable[rec + 3u];
  let shape = i32(a_shape.x + 0.5);
  out.shapeType = shape;
  out.colorStroke = a_colorStroke;
  out.paint = a_paint;
  out.pixelStep = vec4<f32>(1.0, 0.0, 0.0, 1.0);
  // Columns of the inverse of the instance's linear transform.
  let determinant = a_mCol0.x * a_mCol1.y - a_mCol1.x * a_mCol0.y;
  let inverseDeterminant = select(0.0, 1.0 / determinant, abs(determinant) > 1e-12);
  let localStep = vec4<f32>(a_mCol1.y, -a_mCol0.y, -a_mCol1.x, a_mCol0.x) * inverseDeterminant;

  var p: vec2<f32>;
  if (shape == 1) {
    // Circle: center + (unit-0.5)*2*outerRadius.
    let center = a_mTranslate;
    let radius = a_params.x;
    let strokeWidth = a_params.y;
    let outerRadius = radius + strokeWidth * 0.5 + 1.0;
    p = center + (a_unit - vec2<f32>(0.5)) * 2.0 * outerRadius;
    out.varyingPos = p;
    out.colorFill = a_colorFill;
    out.paramsA = vec4<f32>(center, radius, strokeWidth);
    out.paramsB = vec4<f32>(a_params.zw, 0.0, 0.0);
  } else if (shape == 2 || shape == 4) {
    // Round-rect or ellipse: local centered space + affine. The quad must reach as far
    // as the fragment stage samples: the stroke coverage ramp reads up to
    // strokeOffset +/- strokeWidth * 0.5 outside the box, not just the AA
    // feather, or a wide or outside-aligned stroke's outer half falls
    // outside the quad and is clipped.
    let halfExt = a_params.xy;
    let feather = a_shape.y;
    let strokeWidth = a_params.z;
    let strokeOffset = a_params.w;
    let inflate = feather + abs(strokeOffset) + strokeWidth * 0.5;
    let local = (a_unit - vec2<f32>(0.5)) * 2.0 * (halfExt + inflate);
    p = a_mTranslate + a_mCol0 * local.x + a_mCol1 * local.y;
    out.varyingPos = local;
    out.colorFill = a_colorFill;
    out.paramsA = vec4<f32>(halfExt, strokeWidth, strokeOffset);
    out.radii = a_radii;
    out.paramsB = a_srcRect;
    out.pixelStep = localStep;
  } else if (shape == 3) {
    // Drop shadow: local centered space + affine, same walk as round-rect
    // (a circle's shadow is a round-rect shadow with uniform radii). The
    // quad covers both the true border box (for the outset knockout / inset
    // guard) and the blurred, offset, spread shadow box.
    let halfExt = a_params.xy;
    let strokeOffset = a_params.w;
    let sigma = max(a_srcRect.x, 0.0);
    let spread = a_srcRect.y;
    let offset = a_srcRect.zw;
    let trueHalfExt = halfExt + strokeOffset;
    let shadowHalfExt = max(trueHalfExt + spread, vec2<f32>(0.0));
    let pad = 3.0 * sigma;
    let quadHalfExt = max(trueHalfExt, shadowHalfExt + length(offset)) + pad;
    let local = (a_unit - vec2<f32>(0.5)) * 2.0 * quadHalfExt;
    p = a_mTranslate + a_mCol0 * local.x + a_mCol1 * local.y;
    out.varyingPos = local;
    out.colorFill = a_colorFill;
    out.paramsA = vec4<f32>(trueHalfExt, sigma, a_shape.w);
    out.radii = a_radii;
    out.paramsB = vec4<f32>(offset, spread, 0.0);
    out.pixelStep = localStep;
  } else {
    // Textured: affine quad, sample srcRect × tint.
    p = a_mCol0 * a_unit.x + a_mCol1 * a_unit.y + a_mTranslate;
    out.varyingPos = mix(a_srcRect.xy, a_srcRect.zw, a_unit);
    out.colorFill = a_colorFill;
    out.paramsA = vec4<f32>(a_shape.z, 0.0, 0.0, 0.0);
  }

  let clip = frame.proj * vec3<f32>(p, 1.0);
  out.pos = vec4<f32>(clip.xy, 0.0, 1.0);
  return out;
}

// One smooth-corner field sample, (distance, gradient), at `inset` in the tile
// for smoothing step `tile`. `inset` must lie within the sampled texel
// centers, so the sample never blends in a neighboring tile.
fn cornerFieldSample(inset: vec2<f32>, tile: f32) -> vec3<f32> {
  let withinTile = (inset - vec2<f32>(FIELD_PATCH_MIN)) / FIELD_PATCH_SPAN;
  let uv = vec2<f32>(withinTile.x, (tile + withinTile.y) / FIELD_TILES);
  return textureSampleLevel(u_cornerField, u_cornerFieldSamp, uv, 0.0).xyz;
}

// Distance to a box with smooth corners, as (distance, gradient) like
// `roundBoxDistance`. `cornerSmoothing` is each corner's fitted smoothing as
// (top left, top right, bottom right, bottom left), see `fitSquircleCorners`.
// A corner with no smoothing is circular.
fn squircleBoxDistance(
  point: vec2<f32>,
  halfSize: vec2<f32>,
  cornerRadii: vec4<f32>,
  cornerSmoothing: vec4<f32>,
) -> vec3<f32> {
  let radiusColumn = select(cornerRadii.xw, cornerRadii.yz, point.x > 0.0);
  let cornerRadius = select(radiusColumn.x, radiusColumn.y, point.y > 0.0);
  let smoothingColumn = select(cornerSmoothing.xw, cornerSmoothing.yz, point.x > 0.0);
  let smoothing = select(smoothingColumn.x, smoothingColumn.y, point.y > 0.0);
  if (cornerRadius <= 0.0 || smoothing <= 0.0) {
    return roundBoxDistance(point, halfSize, cornerRadii);
  }
  // How far the point lies inside the two sides that meet at this corner, in
  // units of the corner radius: the field's coordinates.
  let inset = (halfSize - abs(point)) / cornerRadius;
  let quadrantSign = select(vec2<f32>(-1.0), vec2<f32>(1.0), point >= vec2<f32>(0.0));
  let sampledMin = FIELD_PATCH_MIN + 0.5 * FIELD_TEXEL;
  let sampledMax = FIELD_PATCH_MIN + FIELD_PATCH_SPAN - 0.5 * FIELD_TEXEL;
  // Deep inside, past the corner's patch, the nearest edge is a straight side.
  if (min(inset.x, inset.y) >= sampledMax) {
    let nearestSide = select(vec2<f32>(0.0, 1.0), vec2<f32>(1.0, 0.0), inset.x < inset.y);
    return vec3<f32>(-min(inset.x, inset.y) * cornerRadius, quadrantSign * nearestSide);
  }
  // Outside the sampled range, measure at its nearest point and carry the rest
  // along the gradient, which keeps the distance continuous past the patch.
  let sampled = clamp(inset, vec2<f32>(sampledMin), vec2<f32>(sampledMax));
  let tileStep = smoothing * (FIELD_TILES - 1.0);
  let lowerTile = floor(tileStep);
  let upperTile = min(lowerTile + 1.0, FIELD_TILES - 1.0);
  let field = mix(
    cornerFieldSample(sampled, lowerTile),
    cornerFieldSample(sampled, upperTile),
    tileStep - lowerTile,
  );
  let insetGradient = field.yz / max(length(field.yz), 1e-6);
  let insetDistance = field.x + dot(insetGradient, inset - sampled);
  // Insets grow away from the sides, so each axis of the gradient turns back
  // toward the point's own quadrant.
  return vec3<f32>(insetDistance * cornerRadius, -quadrantSign * insetGradient);
}

// A local-space shape's fill with its stroke composited over it, from the
// shape's (distance, gradient). The stroke is a band around the edge moved out
// by `strokeOffset`, which aligns it inside, centered or outside. Its distance
// changes as fast as the edge's, so both share one ramp width.
fn fillUnderStroke(in: VOut, shape: vec3<f32>) -> vec4<f32> {
  let strokeWidth = in.paramsA.z;
  let strokeOffset = in.paramsA.w;
  let changePerPixel = distanceChangePerPixel(shape.yz, in.pixelStep);
  let fill = fillColorAt(devicePos(in.pos.xy), in.colorFill, in.paint) * coverage(shape.x, changePerPixel);
  var stroke = vec4<f32>(0.0);
  if (strokeWidth > 0.0) {
    let strokeDistance = abs(shape.x - strokeOffset) - strokeWidth * 0.5;
    stroke = in.colorStroke * coverage(strokeDistance, changePerPixel);
  }
  return stroke + fill * (1.0 - stroke.a);
}

// The fill's premultiplied color at device position `dp`: the flat fill, or a
// sample of its gradient ramp. See the file header for `paint`.
fn fillColorAt(dp: vec2<f32>, colorFill: vec4<f32>, paint: vec4<f32>) -> vec4<f32> {
  if (paint.w <= 0.5) {
    return colorFill;
  }
  let gradT = clamp(dot(dp, paint.xy) - paint.z, 0.0, 1.0);
  // See gradientRadial.wgsl: remap onto texel centers, and ATLAS_ROWS must
  // match TextureManager.ts.
  let gradU = gradT * (255.0 / 256.0) + 0.5 / 256.0;
  let gradV = (paint.w - 1.0 + 0.5) / 64.0;
  return textureSampleLevel(u_ramp, u_rampSamp, vec2<f32>(gradU, gradV), 0.0) * colorFill.a;
}

// Evan Wallace's analytic rounded-box shadow
// (madebyevan.com/shaders/fast-rounded-rectangle-shadows). A closed-form
// approximation of the error function, accurate to about 1.2e-7, used to
// integrate a Gaussian analytically along x.
fn shadowErf(x: f32) -> f32 {
  let s = sign(x);
  let a = abs(x);
  var y = 1.0 + (0.278393 + (0.230389 + (0.000972 + 0.078108 * a) * a) * a) * a;
  y = y * y;
  return s - s / (y * y);
}

fn shadowGaussian(x: f32, sigma: f32) -> f32 {
  return exp(-(x * x) / (2.0 * sigma * sigma)) / (sqrt(2.0 * 3.14159265359) * sigma);
}

// The 1D shadow profile along x at row `y`, for a box of half-size
// `halfExt` whose corner radius on this row's left/right edge is
// `cornerL`/`cornerR` (picked per quadrant by the caller, the same way
// `sdRoundBox` does). `curved` is how far the flat part of the edge is
// pulled in to make room for that corner's arc.
fn shadowBoxX(x: f32, y: f32, sigma: f32, cornerL: f32, cornerR: f32, halfExt: vec2<f32>) -> f32 {
  let deltaL = min(halfExt.y - cornerL - abs(y), 0.0);
  let curvedL = halfExt.x - cornerL + sqrt(max(0.0, cornerL * cornerL - deltaL * deltaL));
  let deltaR = min(halfExt.y - cornerR - abs(y), 0.0);
  let curvedR = halfExt.x - cornerR + sqrt(max(0.0, cornerR * cornerR - deltaR * deltaR));
  let invSigma = 0.70710678118 / sigma; // sqrt(0.5) / sigma
  let intHi = 0.5 + 0.5 * shadowErf((x + curvedL) * invSigma);
  let intLo = 0.5 + 0.5 * shadowErf((x - curvedR) * invSigma);
  return intHi - intLo;
}

/**
 * Shadow coverage (0..1) at local point `p`, relative to a box of half
 * extents `halfExt` and per-corner radii `radii` (tl, tr, br, bl), blurred
 * by Gaussian sigma. Integrates along y in four samples, clamped to the
 * box's own y-extent so a shape thinner than the kernel still samples
 * inside it (a fixed sample count over a fixed +/-3 sigma range would
 * otherwise miss the shape entirely and band).
 */
// `hardCoverage` is the zero-blur result, the shadow box's own SDF coverage.
fn shadowCoverage(p: vec2<f32>, halfExt: vec2<f32>, radii: vec4<f32>, sigma: f32, hardCoverage: f32) -> f32 {
  if (sigma < 1e-4) {
    return hardCoverage;
  }
  let low = p.y - halfExt.y;
  let high = p.y + halfExt.y;
  let start = clamp(-3.0 * sigma, low, high);
  let end = clamp(3.0 * sigma, low, high);
  let step = (end - start) / 4.0;
  var y = start + step * 0.5;
  var value = 0.0;
  for (var i = 0; i < 4; i = i + 1) {
    let rowY = p.y - y;
    // sdRoundBox's own quadrant pick: left column is (tl, bl), right is (tr, br).
    let cornerL = select(radii.x, radii.w, rowY > 0.0);
    let cornerR = select(radii.y, radii.z, rowY > 0.0);
    value = value + shadowBoxX(p.x, rowY, sigma, cornerL, cornerR, halfExt) * shadowGaussian(y, sigma) * step;
    y = y + step;
  }
  return value;
}

@fragment
fn fs_main(in: VOut) -> @location(0) vec4<f32> {
  var outColor: vec4<f32>;
  if (in.shapeType == 1) {
    // Circle, measured in device px. paramsA = (center, radius, strokeWidth),
    // paramsB = (dashStart, dashPeriod, _, _).
    let center = in.paramsA.xy;
    let radius = in.paramsA.z;
    let circStrokeWidth = in.paramsA.w;
    let circDelta = in.varyingPos - center;
    let circle = circleDistance(circDelta, radius);
    let changePerPixel = distanceChangePerPixel(circle.yz, in.pixelStep);
    let fill = fillColorAt(devicePos(in.pos.xy), in.colorFill, in.paint) * coverage(circle.x, changePerPixel);
    var stroke = vec4<f32>(0.0);
    if (circStrokeWidth > 0.0) {
      var strokeAlpha = coverage(abs(circle.x) - circStrokeWidth * 0.5, changePerPixel);
      let dashPeriod = in.paramsB.y;
      if (dashPeriod > 0.0 && strokeAlpha > 0.0) {
        let dashStart = in.paramsB.x;
        let dashOnLen = dashPeriod * 0.5;
        let angle = atan2(circDelta.y, circDelta.x);
        let TWO_PI = 6.28318530718;
        let wrap = select(angle, angle + TWO_PI, angle < 0.0);
        let arcPos = wrap * radius;
        let s = dashStart + arcPos;
        let phase = s - dashPeriod * floor(s / dashPeriod);
        let off = smoothstep(dashOnLen - 0.5, dashOnLen + 0.5, phase);
        strokeAlpha = strokeAlpha * (1.0 - off);
      }
      stroke = in.colorStroke * strokeAlpha;
    }
    outColor = stroke + fill * (1.0 - stroke.a);
    if (outColor.a <= 0.0) {
      discard;
    }
  } else if (in.shapeType == 2 || in.shapeType == 4) {
    // Round-rect or ellipse, measured in local space. paramsA = (half size,
    // strokeWidth, strokeOffset). For an ellipse the half size is its radii.
    var shape: vec3<f32>;
    if (in.shapeType == 2) {
      shape = squircleBoxDistance(in.varyingPos, in.paramsA.xy, in.radii, in.paramsB);
    } else {
      shape = ellipseDistance(in.varyingPos, in.paramsA.xy);
    }
    outColor = fillUnderStroke(in, shape);
    if (outColor.a <= 0.0) {
      discard;
    }
  } else if (in.shapeType == 3) {
    // Drop shadow. paramsA = (true halfExt, sigma, inset), paramsB =
    // (offsetX, offsetY, spread, _). `in.colorFill` carries the shadow's
    // own tint (the record has no separate stroke). Spread changes only the
    // corners that already have a radius: a spread square corner stays
    // square, matching `box-shadow`.
    let sigma = in.paramsA.z;
    let inset = in.paramsA.w;
    let halfExt = in.paramsA.xy;
    // As in CSS, an outset shadow is cast by the border box grown by the
    // spread. An inset one is cast by everything outside a hole, the border
    // box shrunk by the spread, so its coverage is the hole's turned inside
    // out. Either box moves by the offset.
    let grow = select(in.paramsB.z, -in.paramsB.z, inset > 0.5);
    let shadowHasRadius = step(vec4<f32>(1e-6), in.radii);
    let shadowRadii =
      shadowHasRadius * max(in.radii + vec4<f32>(grow), vec4<f32>(0.0));
    let shadowHalfExt = max(halfExt + grow, vec2<f32>(0.0));
    let shadowLocal = in.varyingPos - in.paramsB.xy;
    let shadowBox = roundBoxDistance(shadowLocal, shadowHalfExt, shadowRadii);
    let blurred = shadowCoverage(
      shadowLocal,
      shadowHalfExt,
      shadowRadii,
      sigma,
      coverage(shadowBox.x, distanceChangePerPixel(shadowBox.yz, in.pixelStep)),
    );
    let shadowCov = select(blurred, 1.0 - blurred, inset > 0.5);
    // The shape's own border box, from the same record fields a round-rect
    // instance reads.
    let borderBox = roundBoxDistance(in.varyingPos, halfExt, in.radii);
    let trueCoverage = coverage(borderBox.x, distanceChangePerPixel(borderBox.yz, in.pixelStep));
    // Outset: knocked out of the border box (CSS: "not painted inside the
    // border-box"). Inset: only inside it.
    let mask = select(1.0 - trueCoverage, trueCoverage, inset > 0.5);
    outColor = in.colorFill * (shadowCov * mask);
    if (outColor.a <= 0.0) {
      discard;
    }
  } else if (in.paramsA.x < 0.5) {
    // Textured from the atlas page, times the tint.
    outColor = textureSampleLevel(u_texAtlas, u_texAtlasSamp, in.varyingPos, 0.0) * in.colorFill;
  } else {
    // Textured from the label page, times the tint.
    outColor = textureSampleLevel(u_texLabel, u_texLabelSamp, in.varyingPos, 0.0) * in.colorFill;
  }
  outColor *= clipCoverageRec(devicePos(in.pos.xy), in.clip0, in.clip1, in.clip2, in.clip3);
  if (params.flags.x == 1u) {
    // Dim premultiplied red. `lighter` blend (forced per-run, see
    // `ShapeProgram.drawRun`) accumulates it into a heatmap.
    outColor = vec4<f32>(0.05, 0.0, 0.0, 0.05);
  } else if (params.flags.x == 2u) {
    outColor = params.debugColor;
  }
  return outColor;
}
